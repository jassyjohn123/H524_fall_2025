<?xml version="1.0" encoding="UTF-8"?>
<questestinterop xmlns="http://www.imsglobal.org/xsd/ims_qtiasiv1p2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.imsglobal.org/xsd/ims_qtiasiv1p2 http://www.imsglobal.org/xsd/ims_qtiasiv1p2p1.xsd">
  <assessment ident="week8_contingency" title="Week 8 Assignment - Part A: Multiple Choice">

    <section ident="part_a" title="Part A: Multiple Choice (9 points)">
      <!-- Question 1 -->
      <item ident="q1" title="Contingency Table Basics (1 point)">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html"><![CDATA[<p>A contingency table displays the relationship between:</p>]]></mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="a">
                <material>
                  <mattext>One categorical variable</mattext>
                </material>
              </response_label>
              <response_label ident="b">
                <material>
                  <mattext>Two continuous variables</mattext>
                </material>
              </response_label>
              <response_label ident="c">
                <material>
                  <mattext>Two categorical variables</mattext>
                </material>
              </response_label>
              <response_label ident="d">
                <material>
                  <mattext>One categorical and one continuous variable</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="1" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition>
            <conditionvar>
              <varequal respident="response1">c</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">1</setvar>
          </respcondition>
        </resprocessing>
      </item>

      <!-- Question 2 -->
      <item ident="q2" title="Expected Frequencies (1 point)">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html"><![CDATA[<p>In a chi-square test, the expected frequency for a cell is calculated as:</p>]]></mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="a">
                <material>
                  <mattext>(Row total × Column total) / Grand total</mattext>
                </material>
              </response_label>
              <response_label ident="b">
                <material>
                  <mattext>(Row total + Column total) / 2</mattext>
                </material>
              </response_label>
              <response_label ident="c">
                <material>
                  <mattext>Grand total / Number of cells</mattext>
                </material>
              </response_label>
              <response_label ident="d">
                <material>
                  <mattext>Observed frequency / Total sample size</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="1" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition>
            <conditionvar>
              <varequal respident="response1">a</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">1</setvar>
          </respcondition>
        </resprocessing>
      </item>

      <!-- Question 3 -->
      <item ident="q3" title="Chi-Square Test Assumptions (1 point)">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html"><![CDATA[<p>Which of the following is a requirement for conducting a chi-square test?</p>]]></mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="a">
                <material>
                  <mattext>All expected cell frequencies must be at least 10</mattext>
                </material>
              </response_label>
              <response_label ident="b">
                <material>
                  <mattext>All expected cell frequencies should be at least 5</mattext>
                </material>
              </response_label>
              <response_label ident="c">
                <material>
                  <mattext>The sample must be normally distributed</mattext>
                </material>
              </response_label>
              <response_label ident="d">
                <material>
                  <mattext>Variables must be continuous</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="1" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition>
            <conditionvar>
              <varequal respident="response1">b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">1</setvar>
          </respcondition>
        </resprocessing>
      </item>

      <!-- Question 4 -->
      <item ident="q4" title="Degrees of Freedom (1 point)">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html"><![CDATA[<p>For a 3×4 contingency table (3 rows, 4 columns), what are the degrees of freedom for the chi-square test?</p>]]></mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="a">
                <material>
                  <mattext>7</mattext>
                </material>
              </response_label>
              <response_label ident="b">
                <material>
                  <mattext>6</mattext>
                </material>
              </response_label>
              <response_label ident="c">
                <material>
                  <mattext>12</mattext>
                </material>
              </response_label>
              <response_label ident="d">
                <material>
                  <mattext>11</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="1" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition>
            <conditionvar>
              <varequal respident="response1">b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">1</setvar>
          </respcondition>
        </resprocessing>
      </item>

      <!-- Question 5 -->
      <item ident="q5" title="Interpreting Chi-Square Results (1 point)">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html"><![CDATA[<p>A chi-square test yields p = 0.032. At α = 0.05, what can we conclude?</p>]]></mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="a">
                <material>
                  <mattext>There is no association between the variables</mattext>
                </material>
              </response_label>
              <response_label ident="b">
                <material>
                  <mattext>There is a significant association between the variables</mattext>
                </material>
              </response_label>
              <response_label ident="c">
                <material>
                  <mattext>The variables are normally distributed</mattext>
                </material>
              </response_label>
              <response_label ident="d">
                <material>
                  <mattext>The test assumptions are violated</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="1" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition>
            <conditionvar>
              <varequal respident="response1">b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">1</setvar>
          </respcondition>
        </resprocessing>
      </item>

      <!-- Question 6 -->
      <item ident="q6" title="Relative Risk (1 point)">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html"><![CDATA[<p>In a study of disease and exposure, the relative risk (RR) is:</p>]]></mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="a">
                <material>
                  <mattext>The ratio of the odds of disease in exposed vs. unexposed groups</mattext>
                </material>
              </response_label>
              <response_label ident="b">
                <material>
                  <mattext>The ratio of the risk of disease in exposed vs. unexposed groups</mattext>
                </material>
              </response_label>
              <response_label ident="c">
                <material>
                  <mattext>The difference in risk between exposed and unexposed groups</mattext>
                </material>
              </response_label>
              <response_label ident="d">
                <material>
                  <mattext>Always equal to 1 if there is no association</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="1" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition>
            <conditionvar>
              <varequal respident="response1">b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">1</setvar>
          </respcondition>
        </resprocessing>
      </item>

      <!-- Question 7 -->
      <item ident="q7" title="Odds Ratio (1 point)">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html"><![CDATA[<p>An odds ratio of 2.5 means:</p>]]></mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="a">
                <material>
                  <mattext>The exposed group has 2.5 times the risk of disease compared to unexposed</mattext>
                </material>
              </response_label>
              <response_label ident="b">
                <material>
                  <mattext>The odds of disease in the exposed group are 2.5 times the odds in the unexposed group</mattext>
                </material>
              </response_label>
              <response_label ident="c">
                <material>
                  <mattext>There is a 2.5% difference in disease rates between groups</mattext>
                </material>
              </response_label>
              <response_label ident="d">
                <material>
                  <mattext>The chi-square statistic is 2.5</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="1" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition>
            <conditionvar>
              <varequal respident="response1">b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">1</setvar>
          </respcondition>
        </resprocessing>
      </item>

      <!-- Question 8 -->
      <item ident="q8" title="2×2 Table Setup (1 point)">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html"><![CDATA[<p>In a case-control study examining smoking and lung cancer, which variable should form the rows of a 2×2 table?</p>]]></mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="a">
                <material>
                  <mattext>Smoking status (exposed/unexposed)</mattext>
                </material>
              </response_label>
              <response_label ident="b">
                <material>
                  <mattext>Lung cancer status (case/control)</mattext>
                </material>
              </response_label>
              <response_label ident="c">
                <material>
                  <mattext>Either variable can form rows</mattext>
                </material>
              </response_label>
              <response_label ident="d">
                <material>
                  <mattext>Neither - case-control studies cannot use 2×2 tables</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="1" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition>
            <conditionvar>
              <varequal respident="response1">c</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">1</setvar>
          </respcondition>
        </resprocessing>
      </item>

      <!-- Question 9 -->
      <item ident="q9" title="Fisher's Exact Test (1 point)">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html"><![CDATA[<p>When should Fisher's exact test be used instead of the chi-square test?</p>]]></mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="a">
                <material>
                  <mattext>When sample size is very large (n &gt; 1000)</mattext>
                </material>
              </response_label>
              <response_label ident="b">
                <material>
                  <mattext>When expected cell frequencies are small (less than 5 in one or more cells)</mattext>
                </material>
              </response_label>
              <response_label ident="c">
                <material>
                  <mattext>When variables are continuous</mattext>
                </material>
              </response_label>
              <response_label ident="d">
                <material>
                  <mattext>When there are more than two categories</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="1" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition>
            <conditionvar>
              <varequal respident="response1">b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">1</setvar>
          </respcondition>
        </resprocessing>
      </item>

