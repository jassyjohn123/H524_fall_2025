                    <rect x="230" y="290" width="80" height="60" fill="#4ecdc4" stroke="black" stroke-width="1"/>
                    <rect x="330" y="313" width="80" height="37" fill="#ffcd56" stroke="black" stroke-width="1"/>
                    <rect x="430" y="290" width="80" height="60" fill="#ff9f40" stroke="black" stroke-width="1"/>

                    <!-- Axis labels -->
                    <text x="170" y="375" font-family="Arial" font-size="11" text-anchor="middle" transform="rotate(-45 170 375)">Motor Vehicle</text>
                    <text x="270" y="375" font-family="Arial" font-size="11" text-anchor="middle" transform="rotate(-45 270 375)">Drowning</text>
                    <text x="370" y="375" font-family="Arial" font-size="11" text-anchor="middle" transform="rotate(-45 370 375)">Fire</text>
                    <text x="470" y="375" font-family="Arial" font-size="11" text-anchor="middle" transform="rotate(-45 470 375)">Other</text>

                    <!-- Value labels -->
                    <text x="170" y="190" font-family="Arial" font-size="14" font-weight="bold" text-anchor="middle" fill="white">48%</text>
                    <text x="270" y="280" font-family="Arial" font-size="14" font-weight="bold" text-anchor="middle" fill="white">20%</text>
                    <text x="370" y="305" font-family="Arial" font-size="14" font-weight="bold" text-anchor="middle">12%</text>
                    <text x="470" y="280" font-family="Arial" font-size="14" font-weight="bold" text-anchor="middle" fill="white">20%</text>

                    <!-- Y-axis labels -->
                    <text x="90" y="355" font-family="Arial" font-size="10" text-anchor="end">0%</text>
                    <text x="90" y="315" font-family="Arial" font-size="10" text-anchor="end">20%</text>
                    <text x="90" y="275" font-family="Arial" font-size="10" text-anchor="end">40%</text>
                    <text x="90" y="235" font-family="Arial" font-size="10" text-anchor="end">60%</text>

                    <text x="325" y="45" font-family="Arial" font-size="16" font-weight="bold" text-anchor="middle">Childhood Injury Deaths by Cause</text>
                    <text x="325" y="395" font-family="Arial" font-size="14" text-anchor="middle">Cause of Death</text>
                    <text x="50" y="215" font-family="Arial" font-size="14" text-anchor="middle" transform="rotate(-90 50 215)">Percentage</text>
                  </svg>
                </div>

                <p><strong>Consider these three datasets:</strong></p>
                <ul>
                  <li><strong>Dataset 1:</strong> Number of injury deaths by cause (like the chart above)</li>
                  <li><strong>Dataset 2:</strong> Individual BMI measurements for 100 patients</li>
                  <li><strong>Dataset 3:</strong> Blood types (A, B, AB, O) for 200 donors</li>
                </ul>
              </div>

              <p>a) Explain why a bar chart would be appropriate for Dataset 1 and identify one strength of this visualization. (3 points)<br/>
              b) For Dataset 2, recommend a different visualization that shows the distribution shape and explain why. (3 points)<br/>
              c) For Dataset 3, explain why a pie chart might NOT be the best choice despite having categories. (4 points)</p>
            </mattext>
          </material>
          <response_str ident="response3" rcardinality="Single">
            <render_fib>
              <response_label ident="answer" rshuffle="No"/>
            </render_fib>
          </response_str>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <other/>
            </conditionvar>
            <setvar action="Set" varname="SCORE">0</setvar>
          </respcondition>
        </resprocessing>
      </item>

