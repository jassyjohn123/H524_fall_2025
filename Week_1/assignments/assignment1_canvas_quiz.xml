      <!-- Question 1 -->
      <item ident="q1" title="Question 1">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>4</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html"><strong>Dataset Reference:</strong> Childhood injury deaths by cause: Motor Vehicle (48 deaths), Drowning (20 deaths), Fire (12 deaths), Other causes (20 deaths). Total = 100 deaths.<br/><br/>According to the childhood injury deaths data, approximately what percentage of deaths are due to motor vehicle accidents?</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="a">
                <material>
                  <mattext texttype="text/html">25%</mattext>
                </material>
              </response_label>
              <response_label ident="b">
                <material>
                  <mattext texttype="text/html">35%</mattext>
                </material>
              </response_label>
              <response_label ident="c">
                <material>
                  <mattext texttype="text/html">48%</mattext>
                </material>
              </response_label>
              <response_label ident="d">
                <material>
                  <mattext texttype="text/html">52%</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">c</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
            <displayfeedback feedbacktype="Response" linkrefid="correct1"/>
          </respcondition>
          <respcondition continue="Yes">
            <conditionvar>
              <other/>
            </conditionvar>
            <setvar action="Set" varname="SCORE">0</setvar>
            <displayfeedback feedbacktype="Response" linkrefid="incorrect1"/>
          </respcondition>
        </resprocessing>
        <itemfeedback ident="correct1">
          <flow_mat>
            <material>
              <mattext texttype="text/html">Correct! Motor vehicle accidents account for 48 out of 100 deaths, which is 48%.</mattext>
            </material>
          </flow_mat>
        </itemfeedback>
        <itemfeedback ident="incorrect1">
          <flow_mat>
            <material>
              <mattext texttype="text/html">Incorrect. Motor vehicle accidents account for 48 out of 100 deaths, which equals 48%.</mattext>
            </material>
          </flow_mat>
        </itemfeedback>
      </item>

      <!-- Question 2 with FEV1 Histogram -->
      <item ident="q2" title="Question 2">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>essay_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>10</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">
              <div style="border: 1px solid #ccc; padding: 15px; margin: 15px 0; background-color: #f9f9f9;">
                <h4>FEV1 Distribution Analysis</h4>
                <p><strong>Dataset:</strong> FEV1 measurements (n=13): 2.46, 2.65, 2.69, 2.76, 2.85, 3.15, 2.47, 2.77, 2.78, 2.81, 3.09, 3.18, 3.46 liters</p>

                <div style="text-align: center; margin: 20px 0;">
                  <svg width="500" height="350" xmlns="http://www.w3.org/2000/svg" style="border: 1px solid #ddd;">
                    <!-- Histogram of FEV1 data -->
                    <rect x="80" y="320" width="350" height="2" fill="black"/>
                    <rect x="80" y="80" width="2" height="240" fill="black"/>

                    <!-- Bars -->
                    <rect x="100" y="250" width="60" height="70" fill="#69b7ff" stroke="black" stroke-width="1"/>
                    <rect x="170" y="200" width="60" height="120" fill="#69b7ff" stroke="black" stroke-width="1"/>
                    <rect x="240" y="150" width="60" height="170" fill="#69b7ff" stroke="black" stroke-width="1"/>
                    <rect x="310" y="220" width="60" height="100" fill="#69b7ff" stroke="black" stroke-width="1"/>
                    <rect x="380" y="280" width="60" height="40" fill="#69b7ff" stroke="black" stroke-width="1"/>

                    <!-- Axis labels -->
                    <text x="130" y="340" font-family="Arial" font-size="12" text-anchor="middle">2.4</text>
                    <text x="200" y="340" font-family="Arial" font-size="12" text-anchor="middle">2.7</text>
                    <text x="270" y="340" font-family="Arial" font-size="12" text-anchor="middle">3.0</text>
                    <text x="340" y="340" font-family="Arial" font-size="12" text-anchor="middle">3.3</text>
                    <text x="410" y="340" font-family="Arial" font-size="12" text-anchor="middle">3.6</text>

                    <!-- Y-axis labels -->
                    <text x="70" y="325" font-family="Arial" font-size="10" text-anchor="middle">0</text>
                    <text x="70" y="275" font-family="Arial" font-size="10" text-anchor="middle">2</text>
                    <text x="70" y="225" font-family="Arial" font-size="10" text-anchor="middle">4</text>
                    <text x="70" y="175" font-family="Arial" font-size="10" text-anchor="middle">6</text>

                    <text x="250" y="365" font-family="Arial" font-size="14" text-anchor="middle">FEV1 (liters)</text>
                    <text x="40" y="200" font-family="Arial" font-size="14" text-anchor="middle" transform="rotate(-90 40 200)">Frequency</text>
                    <text x="250" y="40" font-family="Arial" font-size="16" font-weight="bold" text-anchor="middle">FEV1 Distribution (n=13)</text>
                  </svg>
                </div>

                <p><strong>Descriptive Statistics:</strong><br/>
                • Mean: 2.88 liters<br/>
                • Median: 2.78 liters<br/>
                • Range: 1.00 liters (3.46 - 2.46)<br/>
                • Standard deviation: 0.32 liters</p>
              </div>

              <p>a) Given that the mean is 2.88 liters and the median is 2.78 liters, what does this suggest about the distribution's shape? (3 points)<br/>
              b) Calculate and interpret the coefficient of variation for this dataset. Show your work. (4 points)<br/>
              c) If we wanted to compare FEV1 values between males and females in this dataset, what type of visualization would be most appropriate and why? (3 points)</p>
            </mattext>
          </material>
          <response_str ident="response2" rcardinality="Single">
            <render_fib>
              <response_label ident="answer" rshuffle="No"/>
            </render_fib>
          </response_str>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <other/>
            </conditionvar>
            <setvar action="Set" varname="SCORE">0</setvar>
          </respcondition>
        </resprocessing>
      </item>

