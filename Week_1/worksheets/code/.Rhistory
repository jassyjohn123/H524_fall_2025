# Define a reusable mode function
get_mode <- function(x) {
freq_table <- table(x)
modes <- as.numeric(names(freq_table[freq_table == max(freq_table)]))
return(modes)
}
# Define a reusable mode function
get_mode <- function(x) {
freq_table <- table(x)
modes <- as.numeric(names(freq_table[freq_table == max(freq_table)]))
return(modes)
}
