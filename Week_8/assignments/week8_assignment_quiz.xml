  <assessment ident="week8_contingency" title="H524 Week 8: Contingency Tables and Chi-Square Tests">

    <section ident="part_a" title="Part A: Multiple Choice (70 points)">
      <!-- Question 1 -->
      <item ident="q1" title="Contingency Table Basics (10 points)">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>10</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html"><![CDATA[<p>A contingency table displays the relationship between:</p>]]></mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="a">
                <material>
                  <mattext>One categorical variable</mattext>
                </material>
              </response_label>
              <response_label ident="b">
                <material>
                  <mattext>Two continuous variables</mattext>
                </material>
              </response_label>
              <response_label ident="c">
                <material>
                  <mattext>Two categorical variables</mattext>
                </material>
              </response_label>
              <response_label ident="d">
                <material>
                  <mattext>One categorical and one continuous variable</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="1" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition>
            <conditionvar>
              <varequal respident="response1">c</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">1</setvar>
          </respcondition>
        </resprocessing>
      </item>

      <!-- Question 2 -->
      <item ident="q2" title="Expected Frequencies (10 points)">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>10</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html"><![CDATA[<p>In a chi-square test, the expected frequency for a cell is calculated as:</p>]]></mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="a">
                <material>
                  <mattext>(Row total × Column total) / Grand total</mattext>
                </material>
              </response_label>
              <response_label ident="b">
                <material>
                  <mattext>(Row total + Column total) / 2</mattext>
                </material>
              </response_label>
              <response_label ident="c">
                <material>
                  <mattext>Grand total / Number of cells</mattext>
                </material>
              </response_label>
              <response_label ident="d">
                <material>
                  <mattext>Observed frequency / Total sample size</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="1" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition>
            <conditionvar>
              <varequal respident="response1">a</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">1</setvar>
          </respcondition>
        </resprocessing>
      </item>

      <!-- Question 3 -->
      <item ident="q3" title="Chi-Square Test Assumptions (10 points)">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>10</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html"><![CDATA[<p>Which of the following is a requirement for conducting a chi-square test?</p>]]></mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="a">
                <material>
                  <mattext>All expected cell frequencies must be at least 10</mattext>
                </material>
              </response_label>
              <response_label ident="b">
                <material>
                  <mattext>All expected cell frequencies should be at least 5</mattext>
                </material>
              </response_label>
              <response_label ident="c">
                <material>
                  <mattext>The sample must be normally distributed</mattext>
                </material>
              </response_label>
              <response_label ident="d">
                <material>
                  <mattext>Variables must be continuous</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="1" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition>
            <conditionvar>
              <varequal respident="response1">b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">1</setvar>
          </respcondition>
        </resprocessing>
      </item>

      <!-- Question 4 -->
      <item ident="q4" title="Degrees of Freedom (10 points)">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>10</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html"><![CDATA[<p>For a 3×4 contingency table (3 rows, 4 columns), what are the degrees of freedom for the chi-square test?</p>]]></mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="a">
                <material>
                  <mattext>7</mattext>
                </material>
              </response_label>
              <response_label ident="b">
                <material>
                  <mattext>6</mattext>
                </material>
              </response_label>
              <response_label ident="c">
                <material>
                  <mattext>12</mattext>
                </material>
              </response_label>
              <response_label ident="d">
                <material>
                  <mattext>11</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="1" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition>
            <conditionvar>
              <varequal respident="response1">b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">1</setvar>
          </respcondition>
        </resprocessing>
      </item>

      <!-- Question 5 -->
      <item ident="q5" title="Interpreting Chi-Square Results (10 points)">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>10</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html"><![CDATA[<p>A chi-square test yields p = 0.032. At α = 0.05, what can we conclude?</p>]]></mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="a">
                <material>
                  <mattext>There is no association between the variables</mattext>
                </material>
              </response_label>
              <response_label ident="b">
                <material>
                  <mattext>There is a significant association between the variables</mattext>
                </material>
              </response_label>
              <response_label ident="c">
                <material>
                  <mattext>The variables are normally distributed</mattext>
                </material>
              </response_label>
              <response_label ident="d">
                <material>
                  <mattext>The test assumptions are violated</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="1" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition>
            <conditionvar>
              <varequal respident="response1">b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">1</setvar>
          </respcondition>
        </resprocessing>
      </item>

      <!-- Question 6 -->
      <item ident="q6" title="2×2 Table Setup (10 points)">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>10</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html"><![CDATA[<p>In a case-control study examining smoking and lung cancer, which variable should form the rows of a 2×2 table?</p>]]></mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="a">
                <material>
                  <mattext>Smoking status (exposed/unexposed)</mattext>
                </material>
              </response_label>
              <response_label ident="b">
                <material>
                  <mattext>Lung cancer status (case/control)</mattext>
                </material>
              </response_label>
              <response_label ident="c">
                <material>
                  <mattext>Either variable can form rows</mattext>
                </material>
              </response_label>
              <response_label ident="d">
                <material>
                  <mattext>Neither - case-control studies cannot use 2×2 tables</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="1" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition>
            <conditionvar>
              <varequal respident="response1">c</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">1</setvar>
          </respcondition>
        </resprocessing>
      </item>

      <!-- Question 7 -->
      <item ident="q7" title="Fisher's Exact Test (10 points)">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>10</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html"><![CDATA[<p>When should Fisher's exact test be used instead of the chi-square test?</p>]]></mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="a">
                <material>
                  <mattext>When sample size is very large (n &gt; 1000)</mattext>
                </material>
              </response_label>
              <response_label ident="b">
                <material>
                  <mattext>When expected cell frequencies are small (less than 5 in one or more cells)</mattext>
                </material>
              </response_label>
              <response_label ident="c">
                <material>
                  <mattext>When variables are continuous</mattext>
                </material>
              </response_label>
              <response_label ident="d">
                <material>
                  <mattext>When there are more than two categories</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="1" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition>
            <conditionvar>
              <varequal respident="response1">b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">1</setvar>
          </respcondition>
        </resprocessing>
      </item>
    </section>

    <section ident="part_b" title="Part B: R Computational Problems (30 points)">

      <!-- Question 8: Fisher's Exact Test in R -->
      <item ident="q8" title="Fisher's Exact Test in R (15 points)">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>15</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html"><![CDATA[<p><strong>Fisher's Exact Test in R (15 points)</strong></p>
<p>A small clinical trial tests a new treatment for a rare disease with the following results:</p>
<table border="1" cellpadding="5">
<tr><th></th><th>Improved</th><th>Not Improved</th></tr>
<tr><td><strong>Treatment</strong></td><td>7</td><td>3</td></tr>
<tr><td><strong>Control</strong></td><td>2</td><td>8</td></tr>
</table>
<p>Use R to perform Fisher's exact test on this data. What is the two-sided p-value?</p>]]></mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="a">
                <material>
                  <mattext>0.0032</mattext>
                </material>
              </response_label>
              <response_label ident="b">
                <material>
                  <mattext>0.0698</mattext>
                </material>
              </response_label>
              <response_label ident="c">
                <material>
                  <mattext>0.1524</mattext>
                </material>
              </response_label>
              <response_label ident="d">
                <material>
                  <mattext>0.5000</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="1" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition>
            <conditionvar>
              <varequal respident="response1">b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">1</setvar>
          </respcondition>
        </resprocessing>
      </item>

      <!-- Question 9: Chi-Square Test in R -->
      <item ident="q9" title="Chi-Square Test in R (15 points)">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>15</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html"><![CDATA[<p><strong>Chi-Square Test in R (15 points)</strong></p>
<p>A cohort study follows 500 smokers and 500 non-smokers for 10 years to assess heart disease incidence:</p>
<table border="1" cellpadding="5">
<tr><th></th><th>Heart Disease</th><th>No Heart Disease</th></tr>
<tr><td><strong>Smoker</strong></td><td>75</td><td>425</td></tr>
<tr><td><strong>Non-smoker</strong></td><td>35</td><td>465</td></tr>
</table>
<p>Use R to perform a chi-square test on this data (without continuity correction). What is the chi-square test statistic?</p>]]></mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="a">
                <material>
                  <mattext>8.234</mattext>
                </material>
              </response_label>
              <response_label ident="b">
                <material>
                  <mattext>12.156</mattext>
                </material>
              </response_label>
              <response_label ident="c">
                <material>
                  <mattext>16.343</mattext>
                </material>
              </response_label>
              <response_label ident="d">
                <material>
                  <mattext>21.450</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="1" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition>
            <conditionvar>
              <varequal respident="response1">c</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">1</setvar>
          </respcondition>
        </resprocessing>
      </item>

    </section>

