              </response_label>
              <response_label ident="b">
                <material>
                  <mattext>0.04</mattext>
                </material>
              </response_label>
              <response_label ident="c">
                <material>
                  <mattext>0.92</mattext>
                </material>
              </response_label>
              <response_label ident="d">
                <material>
                  <mattext>0.96</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="10" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition>
            <conditionvar>
              <varequal respident="response1">b</varequal>
            </conditionvar>
