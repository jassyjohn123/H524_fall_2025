    </section>

    <!-- Question 11: Risk Measures -->
    <section ident="part4" title="Part 4: Risk Measures">
      <item ident="q11" title="Relative Risk Calculation">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>numerical_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>7</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">In a cohort study: 800 smokers with 120 developing disease, 1200 non-smokers with 24 developing disease. What is the Relative Risk? (Enter to 1 decimal place)</mattext>
          </material>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="7" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition>
            <conditionvar>
              <varequal respident="response1">7.5</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">7</setvar>
          </respcondition>
        </resprocessing>
      </item>
    </section>

