            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>

      <!-- Question 5: Multiple Choice - ANOVA Interpretation -->
      <item ident="q5_mc" title="Question 5: ANOVA Interpretation">
        <itemmetadata>
