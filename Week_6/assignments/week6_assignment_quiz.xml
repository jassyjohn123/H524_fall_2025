      <!-- Question 11: Essay - Power Calculation -->
      <item ident="q11_essay" title="Question 11: Power Calculation">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>essay_question</fieldentry>
