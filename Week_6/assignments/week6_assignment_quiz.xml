      <!-- Question 1: Multiple Choice - Power Definition -->
      <item ident="q1_mc" title="Question 1: Statistical Power">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>2</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html"><![CDATA[
<p><strong>Statistical Power (2 points)</strong></p>
<p>Statistical power is defined as:</p>
            ]]></mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="A">
                <material>
                  <mattext>The probability of making a Type I error</mattext>
                </material>
              </response_label>
              <response_label ident="B">
                <material>
                  <mattext>The probability of correctly rejecting a false null hypothesis</mattext>
                </material>
              </response_label>
              <response_label ident="C">
                <material>
                  <mattext>The probability of failing to reject a true null hypothesis</mattext>
                </material>
              </response_label>
              <response_label ident="D">
                <material>
                  <mattext>The significance level of the test</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">B</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>

