      <!-- Question 4: Multiple Choice - ANOVA vs t-tests -->
      <item ident="q4_mc" title="Question 4: ANOVA Purpose">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>2</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html"><![CDATA[
<p><strong>ANOVA Purpose (2 points)</strong></p>
<p>When comparing means across 4 independent groups, why is ANOVA preferred over multiple pairwise t-tests?</p>
            ]]></mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="A">
                <material>
                  <mattext>ANOVA is easier to calculate</mattext>
                </material>
              </response_label>
              <response_label ident="B">
                <material>
                  <mattext>ANOVA requires smaller sample sizes</mattext>
                </material>
              </response_label>
              <response_label ident="C">
                <material>
                  <mattext>ANOVA controls the family-wise Type I error rate</mattext>
                </material>
              </response_label>
              <response_label ident="D">
                <material>
                  <mattext>ANOVA doesn't require assumptions</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
