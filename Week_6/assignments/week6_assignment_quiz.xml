<p><strong>ANOVA Interpretation (2 points)</strong></p>
<p>An ANOVA test comparing 5 groups yields F = 3.45 with p = 0.02. What can you conclude?</p>
            ]]></mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="A">
                <material>
                  <mattext>All five group means are significantly different from each other</mattext>
                </material>
              </response_label>
              <response_label ident="B">
                <material>
                  <mattext>At least one group mean differs from the others</mattext>
                </material>
              </response_label>
              <response_label ident="C">
                <material>
                  <mattext>The first group differs significantly from the last group</mattext>
                </material>
              </response_label>
              <response_label ident="D">
                <material>
                  <mattext>Groups 1 and 2 have equal means</mattext>
                </material>
              </response_label>
