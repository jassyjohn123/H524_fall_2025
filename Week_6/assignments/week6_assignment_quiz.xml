      <!-- Question 8: Essay - Pooled Standard Deviation -->
      <item ident="q8_essay" title="Question 8: Pooled Standard Deviation">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
